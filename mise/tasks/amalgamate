# serves dist/ and the Node binding's build/core; neither is our output.
# Run `mise run build` for normal use: its dependency runs this task before
# compiling the extension, and its TaskStamp check forces regeneration if
# any declared output was deleted. Direct `mise run amalgamate` is for
# generation only; use `mise run --force amalgamate` to repair missing
# outputs when bypassing build, because mise can otherwise skip them.
#
# The source list includes core's headers, implementation, vendored code,
# generator and toolchain, plus the license embedded in generated files.
# Binding C changes do not regenerate core. Keep the output list aligned
# with Core::LIBRARIES if a library or platform amalgamation is added.
require_relative '../cpython'

CPython.run('mise', 'run', '//tinyactors-core:amalgamate', '--', '--out', CPython::CORE_BUILD.to_s)
