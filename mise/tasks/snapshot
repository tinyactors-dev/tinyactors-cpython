#!/usr/bin/env ruby
#MISE description="Snapshots under load: a deploy rehearsed on a copy of a live host (N actors, R resident, the rest in SQLite, payments in flight), on both datamodels (tools/snapshot.py)"
#MISE depends=["build"]
#USAGE flag "--actors <n>" default="2000000" help="the population"
#USAGE flag "--resident <n>" default="1000" help="the actors in memory at most (equal to --actors: no store)"
#USAGE flag "--events <n>" default="200000" help="the events before the snapshot, and again on each host after it"
# vim:ft=ruby

# The application's side of snapshots as a program writes it: Host.snapshot
# of a live host to a file and a copy of its store; Host.restore of a copy
# with a stand-in payment service, which gets each payment in flight again;
# version 2 added and every actor migrated on the copy, while the live host
# goes on. It fails when the copy's snapshot is not the same bytes, when an
# actor's count, delayed send, payment or version is wrong on either host,
# when the copy reaches the real service, or when more than R actors are
# resident.
# `mise run test --full` runs it at its defaults and with 100,000 actors
# all resident; the fast pass runs small ones.

require_relative '../cpython'

CPython.stress(actors: ENV.fetch('usage_actors', '2000000'), resident: ENV.fetch('usage_resident', '1000'),
               events: ENV.fetch('usage_events', '200000'), tool: 'snapshot')
