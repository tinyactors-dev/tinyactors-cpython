<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="python" name="client" initial="talking">
  <datamodel>
    <data id="pongs" expr="0" />
    <data id="total" expr="-1" />
    <data id="seed" expr="0" />
  </datamodel>
  <state id="talking">
    <invoke id="counter" type="urn:example:counter" src="counter://local">
      <param name="seed" expr="seed" />
    </invoke>
    <transition event="go">
      <send target="#_counter" event="ping">
        <content expr="{'n': pongs}" />
      </send>
    </transition>
    <transition event="pong">
      <assign location="pongs" expr="pongs + 1" />
    </transition>
    <transition event="end">
      <send target="#_counter" event="finish" />
    </transition>
    <transition event="done.invoke.counter" target="finished">
      <assign location="total" expr="_event.data['total']" />
    </transition>
    <transition event="leave" target="left" />
    <transition event="report">
      <log label="report" expr="f'{_sessionid} {pongs} {total} talking'" />
    </transition>
  </state>
  <state id="finished">
    <transition event="report">
      <log label="report" expr="f'{_sessionid} {pongs} {total} finished'" />
    </transition>
  </state>
  <state id="left">
    <transition event="report">
      <log label="report" expr="f'{_sessionid} {pongs} {total} left'" />
    </transition>
  </state>
</scxml>
