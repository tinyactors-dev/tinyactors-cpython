<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="python" name="c" initial="s">
  <state id="s">
    <onentry>
      <log label="n" expr="_name" />
      <log label="s" expr="_sessionid" />
      <log label="p" expr="str(sorted(_ioprocessors))" />
    </onentry>
  </state>
</scxml>
