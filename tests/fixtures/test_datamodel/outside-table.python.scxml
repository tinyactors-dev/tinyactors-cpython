<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="python" name="c" initial="s">
  <state id="s">
    <onentry>
      <send type="urn:test:app" target="app" event="e">
        <content expr="(1, 2)" />
      </send>
    </onentry>
    <transition event="error.execution">
      <log label="e" expr="'refused'" />
    </transition>
  </state>
</scxml>
