<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="python" name="c" initial="s">
  <datamodel>
    <data id="n" expr="0" />
  </datamodel>
  <state id="s">
    <transition event="go">
      <assign location="nope" expr="1" />
      <assign location="n" expr="2" />
    </transition>
    <transition event="error.execution">
      <log label="n" expr="str(n)" />
    </transition>
  </state>
</scxml>
