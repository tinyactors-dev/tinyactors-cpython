<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="python" name="c" initial="s">
  <datamodel>
    <data id="t">hello world</data>
    <data id="l">[1, 2]</data>
  </datamodel>
  <state id="s">
    <onentry>
      <log label="t" expr="t" />
      <log label="l" expr="str(l)" />
    </onentry>
  </state>
</scxml>
